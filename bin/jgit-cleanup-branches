#!/bin/bash

# load common functions and variables
SCRIPT_DIR="$(dirname "$(readlink -f "${0}")")"
. "${SCRIPT_DIR}/../inc/common.sh"

common_setup_env

cd "${REPO_DIR}" || {
    error "Unable to change directories"
    exit 255
}

CUR_BRANCH=$(git symbolic-ref --short HEAD)

cleanup() {
    echo "Cleaning up, returning branch to ${CUR_BRANCH}"
    git checkout "${CUR_BRANCH}"
}

trap cleanup SIGHUP SIGINT SIGQUIT SIGABRT EXIT

git diff --quiet || {
    error "Branch is currently in a dirty state."
    exit 1
}

[ -z "$(git status -s)" ] || {
    error "Branch has uncommited changes."
    exit 1
}

[ -r "${BRANCH_LIST}" ] || {
    error "Couldn't find ${BRANCH_LIST} branch list file"
    exit 1
}

git fetch --prune || {
    error "Failed to prune"
    exit 1
}

while IFS= read -u 3 -r branch_name
do
    [[ ${branch_name} =~ ^#.* ]] && continue
    [[ -z ${branch_name} ]] && continue
    [[ ${branch_name} =~ ^origin\/.* ]] && continue

    git rev-parse "${branch_name}" 2>/dev/null || {
        error "Branch ${branch_name} is missing"
        subl "${BRANCH_LIST}"
        continue
    }

    if branch_apparently_merged "${branch_name}"; then
        sed_cmd="sed"

        if [ "$(uname)" == "Darwin" ]; then
            if ! hash gsed >/dev/null; then
                error "You're on MacOS but don't have gsed installed, please install it."
            fi
        fi

        if hash gsed; then
            sed_cmd="gsed"
        fi

        if ! hash gum; then
            error "Need gum"
        fi

        if gum confirm "Confirm cleaning up ${branch_name}"; then
            git branch -D ${branch_name} || error "Couldn't remove branch from git"
            ${sed_cmd} -i -n "/${branch_name}/!p" ${BRANCH_LIST} || error "Couldn't cleanup from ${BRANCH_LIST}"
        fi
    fi

    echo ""

done 3< "${BRANCH_LIST}"
