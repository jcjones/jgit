#!/bin/bash

# load common functions and variables
SCRIPT_DIR="$(dirname "$(readlink -f "${0}")")"
. "${SCRIPT_DIR}/../inc/common.sh"

common_setup_env

cd "${REPO_DIR}" || {
    error "Unable to change directories"
    exit 255
}

cleanup() {
    info "Cleaning up"
}

trap cleanup SIGHUP SIGINT SIGQUIT SIGABRT EXIT

if ! hash gum ; then
    error "Missing gum, please install it"
    exit 99
fi

for branch in $(git branch); do
    if branch_apparently_merged "${branch}" ; then
        git show -q "${branch}"
        gum confirm "Delete ${branch}"
        err="$?"

        case $err in
            0) git branch -D "${branch}" ;;
            1) echo "Skipping" ;;
            *) exit 255 ;;
        esac
    fi
done